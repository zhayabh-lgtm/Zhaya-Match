{
  "version": 2,
  "builds": [
    {
      "src": "api/public/config.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/public/analytics.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/public/health.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/cron/health.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/admin/analytics.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/admin/live-invites.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/public/live-invite.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/public/live-ics.ts",
      "use": "@vercel/node"
    },
    {
      "src": "server.ts",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "crons": [
    {
      "path": "/api/cron/health",
      "schedule": "0 0 * * *"
    }
  ],
  "routes": [
    {
      "src": "/widget.js",
      "headers": {
        "Content-Type": "application/javascript; charset=utf-8",
        "Access-Control-Allow-Origin": "*",
        "Cross-Origin-Resource-Policy": "cross-origin",
        "Cache-Control": "public, max-age=60, s-maxage=60"
      }
    },
    {
      "src": "/api/health",
      "dest": "/api/public/health.ts",
      "headers": {
        "Content-Type": "application/json; charset=utf-8",
        "Access-Control-Allow-Origin": "*",
        "Cache-Control": "no-store"
      }
    },
    {
      "src": "/api/cron/health",
      "dest": "/api/cron/health.ts",
      "headers": {
        "Content-Type": "application/json; charset=utf-8",
        "Cache-Control": "no-store"
      }
    },
    {
      "src": "/api/public/config",
      "dest": "/api/public/config.ts",
      "headers": {
        "Content-Type": "application/json; charset=utf-8",
        "Access-Control-Allow-Origin": "*",
        "Cross-Origin-Resource-Policy": "cross-origin",
        "Cache-Control": "no-store, no-cache, must-revalidate"
      }
    },
    {
      "src": "/api/public/analytics",
      "dest": "/api/public/analytics.ts",
      "headers": {
        "Content-Type": "application/json; charset=utf-8",
        "Access-Control-Allow-Methods": "POST, OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type",
        "Cache-Control": "no-store"
      }
    },
    {
      "src": "/api/admin/analytics",
      "dest": "/api/admin/analytics.ts",
      "headers": {
        "Content-Type": "application/json; charset=utf-8",
        "Access-Control-Allow-Methods": "GET, OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type, Authorization",
        "Cache-Control": "no-store"
      }
    },
    {
      "src": "/api/admin/live-invites",
      "dest": "/api/admin/live-invites.ts",
      "headers": {
        "Content-Type": "application/json; charset=utf-8",
        "Access-Control-Allow-Methods": "GET, POST, DELETE, OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type, Authorization",
        "Cache-Control": "no-store"
      }
    },
    {
      "src": "/api/public/live-invite",
      "dest": "/api/public/live-invite.ts",
      "headers": {
        "Content-Type": "application/json; charset=utf-8",
        "Access-Control-Allow-Methods": "GET, OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type",
        "Cache-Control": "public, max-age=15, s-maxage=30"
      }
    },
    {
      "src": "/api/public/live-ics",
      "dest": "/api/public/live-ics.ts",
      "headers": {
        "Content-Type": "text/calendar; charset=utf-8",
        "Access-Control-Allow-Methods": "GET, OPTIONS",
        "Cache-Control": "public, max-age=60, s-maxage=120"
      }
    },
    {
      "src": "/widget-status",
      "dest": "/server.ts",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Cross-Origin-Resource-Policy": "cross-origin"
      }
    },
    {
      "src": "/api/(.*)",
      "dest": "/server.ts",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "GET, POST, OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type, Authorization"
      }
    },
    {
      "src": "/assets/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}