{
  "version": 2,
  "builds": [
    {
      "src": "api/public/config.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/public/analytics.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/public/health.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/cron/health.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/admin/analytics.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/admin/live-invites.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/public/live-invite.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/public/live-ics.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/public/live-click.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/best-sellers.ts",
      "use": "@vercel/node"
    },
    {
      "src": "server.ts",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "crons": [
    {
      "path": "/api/cron/health",
      "schedule": "0 0 * * *"
    }
  ],
  "headers": [
    {
      "source": "/widget.js",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "cross-origin"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, s-maxage=60"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/health",
      "destination": "/api/public/health.ts"
    },
    {
      "source": "/widget-status",
      "destination": "/server.ts"
    },
    {
      "source": "/api/best-sellers",
      "destination": "/api/best-sellers.ts"
    },
    {
      "source": "/api/public/config",
      "destination": "/api/public/config.ts"
    },
    {
      "source": "/api/public/analytics",
      "destination": "/api/public/analytics.ts"
    },
    {
      "source": "/api/public/health",
      "destination": "/api/public/health.ts"
    },
    {
      "source": "/api/cron/health",
      "destination": "/api/cron/health.ts"
    },
    {
      "source": "/api/admin/analytics",
      "destination": "/api/admin/analytics.ts"
    },
    {
      "source": "/api/admin/live-invites",
      "destination": "/api/admin/live-invites.ts"
    },
    {
      "source": "/api/public/live-invite",
      "destination": "/api/public/live-invite.ts"
    },
    {
      "source": "/api/public/live-ics",
      "destination": "/api/public/live-ics.ts"
    },
    {
      "source": "/api/public/live-click",
      "destination": "/api/public/live-click.ts"
    },
    {
      "source": "/api/:path*",
      "destination": "/server.ts"
    },
    {
      "source": "/admin/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/mais-vendidos/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/live/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/login",
      "destination": "/index.html"
    },
    {
      "source": "/reset-password",
      "destination": "/index.html"
    },
    {
      "source": "/preview",
      "destination": "/index.html"
    },
    {
      "source": "/",
      "destination": "/index.html"
    }
  ]
}
