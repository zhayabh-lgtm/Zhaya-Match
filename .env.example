# ==============================================================================
# CONFIGURAÇÃO DE CHAVES SUPABASE DO ZHAYA MATCH
# ==============================================================================

# CHAVES PÚBLICAS (CLIENT-SIDE)
# Utilizadas pelo navegador para leitura de dados públicos (tabelas de medidas, temas, etc.)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# CHAVES PRIVILEGIADAS (SERVER-SIDE / BACKEND SOMENTE)
# Utilizadas exclusivamente pelo servidor Vercel / Node backend para escrita de analytics e operações administrativas.
# CRÍTICO: NUNCA ADICIONE O PREFIXO VITE_ NA CHAVE SERVICE_ROLE!
# Expor SUPABASE_SERVICE_ROLE_KEY ao navegador compromete totalmente a segurança do banco de dados.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=


# CLOUDINARY (SERVER-SIDE)
# Pode usar a URL padrão copiada do Cloudinary OU as 3 variáveis separadas.
# Nunca use VITE_ no API Secret.
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
